#!/usr/bin/env bash
set -euo pipefail

# codex-bundle: render the AutoVault-managed Codex automation from signed skill
# templates, symlink the rendered directory into Codex, and record a
# machine-local render index so `autovault doctor` can verify render fidelity
# non-interactively.
#
# This helper only RENDERS and RECORDS. The first-class drift check is now
# `autovault doctor [--json]`, which re-verifies the signed templates and
# hash-compares them against this index. There is no local `check` action.

usage() {
  cat >&2 <<'TEXT'
Usage:
  codex-bundle install --project-root PATH [--automation-id ID] [--replace-existing]

Required:
  --project-root  Absolute path to the target repository (no shipped default).

Defaults:
  --automation-id docs-drift-scout

Environment:
  CODEX_HOME                 ${CODEX_HOME:-$HOME/.codex}
  AUTOVAULT_STORAGE_PATH     ${AUTOVAULT_STORAGE_PATH:-$HOME/.autovault}

Audit the rendered state with:
  autovault doctor codex-docs-drift-scout --json
TEXT
  exit 2
}

die() {
  printf 'codex-bundle: %s\n' "$*" >&2
  exit 1
}

action="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$action" in
  install) ;;
  *) usage ;;
esac

project_root=""
codex_home="${CODEX_HOME:-$HOME/.codex}"
automation_id="docs-drift-scout"
replace_existing="false"

expand_home() {
  case "$1" in
    "~") printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s/%s\n' "$HOME" "${1#~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

absolute_path() {
  local raw
  raw="$(expand_home "$1")"
  case "$raw" in
    /*) printf '%s\n' "$raw" ;;
    *) printf '%s/%s\n' "$(pwd -P)" "$raw" ;;
  esac
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --project-root)
      project_root="${2:?--project-root requires a path}"
      shift 2
      ;;
    --project-root=*)
      project_root="${1#--project-root=}"
      shift
      ;;
    --automation-id)
      automation_id="${2:?--automation-id requires a value}"
      shift 2
      ;;
    --automation-id=*)
      automation_id="${1#--automation-id=}"
      shift
      ;;
    --replace-existing)
      replace_existing="true"
      shift
      ;;
    --help|-h)
      usage
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[[ -n "$project_root" ]] || die "--project-root is required (no shipped default)"
[[ "$automation_id" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die "invalid automation id: $automation_id"

project_root="$(expand_home "$project_root")"
[[ -d "$project_root" ]] || die "project root does not exist: $project_root"
project_root="$(cd "$project_root" && pwd -P)"

storage_path="$(absolute_path "${AUTOVAULT_STORAGE_PATH:-$HOME/.autovault}")"
codex_home="$(absolute_path "$codex_home")"
render_root="$storage_path/rendered/codex-automations/$automation_id"

rendered_at_ms="$(date +%s)000"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
skill_root="$(cd "$script_dir/.." && pwd -P)"
skill_name="$(basename "$skill_root")"
automation_template="$skill_root/resources/codex/automation.toml.tpl"
environment_template="$skill_root/resources/codex/environment.toml.tpl"
automation_template_rel="resources/codex/automation.toml.tpl"
environment_template_rel="resources/codex/environment.toml.tpl"
automation_path="$render_root/automation.toml"
environment_path="$render_root/environment.toml"
codex_automation_dir="$codex_home/automations"
codex_link="$codex_automation_dir/$automation_id"
render_index_path="$storage_path/render-index.json"

[[ -f "$automation_template" ]] || die "missing template: $automation_template"
[[ -f "$environment_template" ]] || die "missing template: $environment_template"

command -v python3 >/dev/null 2>&1 || die "python3 is required to validate rendered TOML and record the render index"

render_template() {
  local template="$1"
  local content
  content="$(<"$template")"
  content="${content//\{\{PROJECT_ROOT\}\}/$project_root}"
  content="${content//\{\{CODEX_HOME\}\}/$codex_home}"
  content="${content//\{\{AUTOMATION_ID\}\}/$automation_id}"
  content="${content//\{\{RENDER_ROOT\}\}/$render_root}"
  content="${content//\{\{RENDERED_AT_MS\}\}/$rendered_at_ms}"
  printf '%s\n' "$content"
}

write_rendered() {
  local template="$1"
  local target="$2"
  local tmp
  tmp="${target}.tmp.$$"
  render_template "$template" > "$tmp"
  mv "$tmp" "$target"
  chmod 600 "$target" 2>/dev/null || true
}

# Validate an existing render index before rendering, then validate the rendered
# TOML and atomically write/refresh the index entry. The index records, per
# bundle: the owning skill, the render root, the managed link root, the symlink
# path, the vault-template content hashes (the same bytes `autovault doctor`
# re-verifies), and the rendered-file hashes.
record_render_index() {
  local mode="${1:-write}"
  local rendered_automation="${2:-$automation_path}"
  local rendered_environment="${3:-$environment_path}"
  python3 - \
    "$mode" \
    "$render_index_path" \
    "$skill_name" \
    "$render_root" \
    "$codex_automation_dir" \
    "$codex_link" \
    "$automation_template_rel" "$automation_template" \
    "$environment_template_rel" "$environment_template" \
    "$rendered_automation" \
    "$rendered_environment" <<'PY'
import hashlib
import json
import os
import sys
import tempfile
import tomllib

(
    mode,
    index_path,
    skill,
    render_root,
    link_root,
    symlink,
    automation_tpl_rel,
    automation_tpl_abs,
    environment_tpl_rel,
    environment_tpl_abs,
    automation_rendered,
    environment_rendered,
) = sys.argv[1:]

HASH_LENGTH = 64


def corrupt(reason):
    sys.stderr.write(f"codex-bundle: render index is corrupt: {reason}\n")
    sys.exit(4)


def safe_relative(value):
    if not isinstance(value, str) or not value:
        return False
    normalized = value.replace("\\", "/")
    if normalized.startswith("/") or (
        len(normalized) >= 2
        and normalized[0].isalpha()
        and normalized[1] == ":"
    ):
        return False
    return all(part not in ("", ".", "..") for part in normalized.split("/"))


def contained(child, parent):
    try:
        return os.path.commonpath(
            (os.path.abspath(child), os.path.abspath(parent))
        ) == os.path.abspath(parent)
    except (OSError, ValueError):
        return False


def validate_hashes(value, label):
    if not isinstance(value, list) or not value:
        corrupt(f"{label} must be a non-empty array")
    seen = set()
    for item in value:
        if not isinstance(item, dict):
            corrupt(f"{label} contains a non-object entry")
        item_path = item.get("path")
        item_hash = item.get("hash")
        if not safe_relative(item_path):
            corrupt(f"{label} contains an unsafe path")
        if (
            not isinstance(item_hash, str)
            or len(item_hash) != HASH_LENGTH
            or any(character not in "0123456789abcdef" for character in item_hash)
        ):
            corrupt(f"{label} contains an invalid hash")
        if item_path in seen:
            corrupt(f"{label} contains a duplicate path")
        seen.add(item_path)


def validate_index(value):
    if not isinstance(value, dict):
        corrupt("root must be an object")
    version = value.get("version")
    if isinstance(version, bool) or version != 1:
        corrupt("unsupported version")
    entries = value.get("entries")
    if not isinstance(entries, list):
        corrupt("entries must be an array")

    render_boundary = os.path.join(os.path.dirname(index_path), "rendered")
    seen_symlinks = set()
    for entry in entries:
        if not isinstance(entry, dict):
            corrupt("entries contains a non-object value")
        entry_skill = entry.get("skill")
        entry_render_root = entry.get("renderRoot")
        entry_link_root = entry.get("linkRoot")
        entry_symlink = entry.get("symlink")
        if (
            not isinstance(entry_skill, str)
            or not entry_skill
            or not entry_skill[0].isalnum()
            or any(
                character
                not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_"
                for character in entry_skill
            )
        ):
            corrupt("entry has an invalid skill name")
        if not all(
            isinstance(candidate, str) and candidate and os.path.isabs(candidate)
            for candidate in (entry_render_root, entry_link_root, entry_symlink)
        ):
            corrupt("entry paths must be absolute")
        if not contained(entry_render_root, render_boundary):
            corrupt("entry renderRoot escapes the rendered boundary")
        if os.path.dirname(os.path.abspath(entry_symlink)) != os.path.abspath(entry_link_root):
            corrupt("entry symlink escapes its linkRoot")
        resolved_symlink = os.path.abspath(entry_symlink)
        if resolved_symlink in seen_symlinks:
            corrupt("entries contain a duplicate symlink")
        seen_symlinks.add(resolved_symlink)
        validate_hashes(entry.get("templates"), "templates")
        validate_hashes(entry.get("rendered"), "rendered")

    return entries


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


index = {"version": 1, "entries": []}
try:
    with open(index_path, "r", encoding="utf-8") as handle:
        index = json.load(handle)
except FileNotFoundError:
    pass
except (OSError, json.JSONDecodeError) as error:
    corrupt(str(error))

entries = validate_index(index)
if mode == "validate":
    sys.exit(0)
if mode not in ("check", "write"):
    corrupt(f"unknown validation mode: {mode}")

# Install-time TOML validity gate. A buggy template or substitution that yields
# invalid TOML fails the install here, before anything is symlinked. Post-install
# the rendered file is hash-verified unchanged, so doctor never needs to parse it.
for rendered in (automation_rendered, environment_rendered):
    try:
        with open(rendered, "rb") as handle:
            tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError) as error:
        sys.stderr.write(f"codex-bundle: rendered TOML did not parse ({rendered}): {error}\n")
        sys.exit(3)

if mode == "check":
    sys.exit(0)

entry = {
    "skill": skill,
    "renderRoot": render_root,
    "linkRoot": link_root,
    "symlink": symlink,
    "templates": [
        {"path": automation_tpl_rel, "hash": sha256_file(automation_tpl_abs)},
        {"path": environment_tpl_rel, "hash": sha256_file(environment_tpl_abs)},
    ],
    "rendered": [
        {
            "path": os.path.basename(automation_rendered),
            "hash": sha256_file(automation_rendered),
        },
        {
            "path": os.path.basename(environment_rendered),
            "hash": sha256_file(environment_rendered),
        },
    ],
}

# Replace any prior entry that published the same Codex symlink (re-install).
index["entries"] = [
    existing
    for existing in entries
    if existing.get("symlink") != symlink
]
index["entries"].append(entry)
validate_index(index)

directory = os.path.dirname(index_path) or "."
os.makedirs(directory, exist_ok=True)
fd, tmp_path = tempfile.mkstemp(prefix=".render-index.", dir=directory)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(index, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.replace(tmp_path, index_path)
    try:
        os.chmod(index_path, 0o600)
    except OSError:
        pass
except BaseException:
    try:
        os.unlink(tmp_path)
    except OSError:
        pass
    raise
PY
}

publish_symlink() {
  python3 - "$render_root" "$codex_link" <<'PY'
import os
import sys

target, link = sys.argv[1:]
temporary = f"{link}.tmp.{os.getpid()}"
try:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
    os.symlink(target, temporary)
    os.replace(temporary, link)
finally:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
PY
}

install_bundle() {
  if [[ ! -L "$codex_link" && -e "$codex_link" && "$replace_existing" != "true" ]]; then
    die "Codex automation path exists and is not a symlink: $codex_link (rerun with --replace-existing to move it aside)"
  fi

  # Refuse a corrupt or unsupported index before writing any rendered state.
  record_render_index validate

  mkdir -p "$storage_path"
  local stage_root stage_automation stage_environment
  stage_root="$(mktemp -d "$storage_path/.codex-bundle.$automation_id.XXXXXX")"
  stage_automation="$stage_root/automation.toml"
  stage_environment="$stage_root/environment.toml"
  trap 'rm -rf "$stage_root"' EXIT

  write_rendered "$automation_template" "$stage_automation"
  write_rendered "$environment_template" "$stage_environment"
  record_render_index check "$stage_automation" "$stage_environment"

  mkdir -p "$render_root" "$codex_automation_dir"
  chmod 700 "$render_root" 2>/dev/null || true
  mv -f "$stage_automation" "$automation_path"
  mv -f "$stage_environment" "$environment_path"
  rm -rf "$stage_root"
  stage_root=""
  trap - EXIT

  # Gate + record before publishing the symlink, so an invalid render never
  # results in a live Codex automation pointing at it.
  record_render_index write

  if [[ ! -L "$codex_link" && -e "$codex_link" ]]; then
    backup="${codex_link}.backup.$(date +%Y%m%d%H%M%S)"
    mv "$codex_link" "$backup"
    printf 'moved existing Codex automation path to %s\n' "$backup"
  fi
  publish_symlink

  printf 'rendered automation: %s\n' "$automation_path"
  printf 'rendered environment: %s\n' "$environment_path"
  printf 'render index: %s\n' "$render_index_path"
  printf 'codex symlink: %s -> %s\n' "$codex_link" "$render_root"
  printf 'audit with: autovault doctor %s --json\n' "$skill_name"
}

install_bundle
